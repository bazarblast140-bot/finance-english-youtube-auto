# Copy this to .env and fill in. NEVER commit .env to git.

# --- Anthropic (script, visuals, verify) ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (voice) ---
ELEVENLABS_API_KEY=

# --- Telegram notification ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube (only needed when you enable publishing) ---
# OAuth client + refresh token for the FINANCE channel (separate from Hindi channel!)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
